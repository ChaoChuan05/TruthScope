# Application
APP_ENV=development
LOG_LEVEL=INFO

# Gonka Router: API key required for live verification.
GONKA_BASE_URL=https://api.gonkarouter.io
GONKA_API_KEY=

# Keep verifier A, verifier B, and judge model IDs distinct.
GONKA_ORCHESTRATOR_MODEL=MiniMaxAI/MiniMax-M2.7
GONKA_MODEL_A=moonshotai/Kimi-K2.6
GONKA_MODEL_B=MiniMaxAI/MiniMax-M2.7
GONKA_JUDGE_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
GONKA_BIAS_AUDITOR_MODEL=MiniMaxAI/MiniMax-M2.7

# Bounded provider timeouts and retries. Sequential verifiers are safer by default.
GONKA_TIMEOUT_SECONDS=30
GONKA_MAX_RETRIES=2
GONKA_MAX_TOKENS=2048
GONKA_PARALLEL_VERIFIERS=false
GONKA_VERIFIER_TIMEOUT_SECONDS=120
GONKA_VERIFIER_MAX_RETRIES=1
GONKA_JUDGE_TIMEOUT_SECONDS=75
GONKA_JUDGE_MAX_RETRIES=1
GONKA_AUDIT_TIMEOUT_SECONDS=60
GONKA_AUDIT_MAX_RETRIES=1

# Input and evidence bounds
MAX_EVIDENCE_PER_CLAIM=12
MAX_INPUT_CHARS=5000

# Brave Search: key required to retrieve public evidence for text claims.
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com
BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COUNTRY=MY
BRAVE_SEARCH_LANGUAGE=en
BRAVE_SEARCH_RESULTS_PER_QUERY=3

# Supabase Auth and persistence.
# Use a backend-only secret key; never expose it to frontend code or commit real credentials.
# When both values are set, Bearer tokens are validated and results are stored through Supabase RPCs.
SUPABASE_URL=
SUPABASE_KEY=
